{
	"name": "transly",
	"version": "0.2.0",
	"description": "Cache-driven incremental translation (via LLM, GoogleTranslate, etc.)",
	"keywords": [
		"i18n",
		"i18next",
		"internationalization",
		"translation",
		"localization",
		"l10n",
		"globalization"
	],
	"homepage": "https://github.com/translate-tools/transly",
	"bugs": {
		"url": "https://github.com/translate-tools/transly/issues"
	},
	"author": "Robert Vitonsky <robert@vitonsky.net>",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"onFail": "error"
		}
	},
	"bin": {
		"transly": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"files": ["dist", "LICENSE", "README.md"],
	"scripts": {
		"build": "tsdown",
		"test": "vitest",
		"publish": "npm test && npm run build && npm publish .publish",
		"example": "cd examples/free && tsx ../../src/cli translate",
		"preview": "cd examples/free && tsx ../../dist/cli translate",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"anylang": "^3.3.3",
		"commander": "^14.0.0",
		"find-up": "^8.0.0",
		"openai": "^6.34.0",
		"zod": "^3.25.28"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"dotenv": "^17.4.2",
		"memfs": "^4.0.0",
		"tsdown": "^0.12.0",
		"typescript": "^5.9.3",
		"vitest": "^3.0.0"
	}
}
